{
  "name": "kladappen",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config app/vite.config.ts --host 127.0.0.1",
    "build": "tsc --project app/tsconfig.json && vite build --config app/vite.config.ts",
    "start": "node app/server/index.mjs",
    "start:lan": "node app/server/index.mjs --lan",
    "fetch": "node fetch-zalando.mjs",
    "fetch:asos": "node fetch-asos.mjs",
    "test": "node --test fetch-zalando.test.mjs product-data.test.mjs product-images.test.mjs import-sources.test.mjs app/server/database.test.mjs app/server/catalog-pages.test.mjs app/server/postgres.test.mjs app/src/swipe.test.mjs",
    "start:supabase": "node --env-file=.env.supabase.local app/server/index.mjs --lan",
    "check:supabase": "node --env-file=.env.supabase.local scripts/check-supabase.mjs",
    "migrate:supabase": "node --env-file=.env.supabase.local scripts/migrate-to-supabase.mjs"
  },
  "dependencies": {
    "express": "latest",
    "lucide-react": "latest",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
